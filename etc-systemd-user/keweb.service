[Unit]
Description=keweb FLAC Lossless Music Player Server Daemon (user)
Documentation=https://github.com/ravachol/kew
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jo/playering-flac
EnvironmentFile=/home/jo/playering-flac/.env
ExecStart=/usr/bin/node /home/jo/playering-flac/server/src/index.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
