[Unit]
Description=keweb Cloudflare Tunnel Remote Daemon (user)
After=keweb.service
Wants=keweb.service

[Service]
Type=simple
WorkingDirectory=/home/jo/playering-flac
EnvironmentFile=/home/jo/playering-flac/.env
ExecStart=/home/jo/playering-flac/bin/cloudflared tunnel run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
