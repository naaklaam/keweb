[Unit]
Description=keweb Cloudflare Tunnel Remote Daemon (root)
After=keweb.service
Wants=keweb.service

[Service]
Type=simple
User=jo
Group=jo
WorkingDirectory=/home/jo/playering-flac
EnvironmentFile=/home/jo/playering-flac/.env
# Token dibaca dari TUNNEL_TOKEN di .env (dipasok EnvironmentFile di atas).
# Jangan taruh token di baris ini; itu akan bocor ke cmdline `ps`.
ExecStart=/home/jo/playering-flac/bin/cloudflared tunnel run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
